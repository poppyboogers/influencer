{
  "source": "loveheart.prepared.glb",
  "output": "loveheart.rigged.glb",
  "rebuildComment": "'npm run rebuild -- loveheart' prepares 'export' into 'source' (shrinks the textures) and rigs it. 'export' is the reduced model, made from the original 4.8 million triangle loveheart.glb by the command in 'reduceCommand': 62k triangles for the model plus 30k kept for the face (the 'detail' box), stood on y = 0 at 2.25 tall.",
  "reduceCommand": "node --max-old-space-size=8000 scripts/reduce-glb.mjs characters/loveheart/loveheart.glb characters/loveheart/loveheart.lowpoly.glb --triangles 62000 --detail \"{\\\"x\\\":[-0.3,0.3],\\\"y\\\":[1.47,1.9],\\\"z\\\":[0.1,1],\\\"triangles\\\":30000}\"",
  "export": "loveheart.lowpoly.glb",
  "comment": "Coordinates are in model units: x = character's left, y = up (feet at 0), z = forward. Bones marked mirror are copied to the right side with x negated. Measured with scripts/measure-glb.mjs on loveheart.prepared.glb (one fused mesh: body, hair, dress and tail; T-pose; mouth and eyes are painted on).",
  "viewComment": "Camera framing in the app (the head is large, so the default framing cuts the hair off).",
  "view": { "target": [0, 1.58, 0], "distance": 2.9 },
  "relaxedArmsComment": "Where the arms rest while the body tracker does not see them (left arm; the right is mirrored). Held out to the sides so the hands clear the tutu.",
  "relaxedArms": { "upper": [0.75, -0.62, 0.1], "lower": [0.85, -0.45, 0.25] },
  "materialComment": "The model's textures mark the dress and mouth as metal, which renders as dark chrome. 0 turns the metal off.",
  "material": { "metallic": 0 },
  "smoothIterations": 5,

  "mouthComment": "The mouth is painted on (open, smiling) with no opening in the mesh, so nothing is cut: the jaw's hold grows smoothly from the upper lip line (planeY) to the bottom of the lower lip (cornerBand below it), which stretches the painted mouth taller as the jaw opens and squashes it to a line when it closes. cornerZ is set out of reach so that gradient is used across the whole mouth. restOpen = how far (radians) the jaw turns up when the tracked mouth is closed.",
  "mouth": {
    "cut": false,
    "interior": false,
    "restOpen": 0.24,
    "planeY": 1.603,
    "minZ": 0.2,
    "maxAbsX": 0.17,
    "bodyZ": [0.1, 0.2],
    "cornerZ": 9,
    "cornerBand": [0.0, 0.045],
    "fadeY": [1.47, 1.5]
  },

  "softComment": "The mesh is one fused surface, so the soft parts are picked by position ('boxes') and texture colour ('color': 'any' = boxes alone). type 'body' = keeps its modelled shape and wobbles around it. 'base' = the only ordinary bones the part may follow (the hair must never follow the shoulders). 'softness': points inside the 'pin' boxes are held, and the part gets softer over 'fade' units along the surface away from them. sim: 'follow' = pull back to the modelled shape per step (higher = stiffer), 'maxOffset' = furthest a point may drift.",
  "soft": [
    {
      "name": "hair", "type": "body", "parent": "head", "points": 64, "links": 4,
      "base": ["head"],
      "selectComment": "Everything above the brows (bun, ears, bow), the back half of the head, the locks beside the face, the locks hanging below chin level outside the neck, and the back hair down to the shoulders. The face itself is left out so expressions can move it.",
      "select": {
        "color": "any", "fill": 0,
        "boxes": [
          { "y": [1.86, 3] },
          { "y": [1.5, 1.86], "z": [-1, 0.08] },
          { "y": [1.5, 1.86], "absX": [0.27, 1] },
          { "y": [1.45, 1.5], "absX": [0.1, 1] },
          { "y": [1.38, 1.5], "z": [-1, -0.12] }
        ]
      },
      "softness": { "pin": [{ "absX": [0, 0.26], "y": [1.44, 2.02], "z": [-0.26, 0.3] }], "fade": 0.3 },
      "sim": { "gravity": 2.0, "damping": 0.08, "follow": 0.06, "stiffness": 1.0, "wind": 0.06, "maxOffset": 0.07 }
    },
    {
      "name": "skirt", "type": "body", "parent": "hips", "points": 48, "links": 5,
