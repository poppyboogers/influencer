      "softness": { "pin": [{ "y": [0.97, 1.2], "absX": [0, 0.2], "z": [-0.15, 0.25] }], "fade": 0.3 },
      "sim": { "gravity": 1.0, "damping": 0.1, "follow": 0.15, "stiffness": 1.0, "wind": 0.1, "maxOffset": 0.05 }
    },
    {
      "name": "tail", "type": "body", "parent": "hips", "points": 16, "links": 3,
